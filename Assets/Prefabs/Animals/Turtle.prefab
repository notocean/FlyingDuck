--- !u!114 &5689681730234073295
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2725268291608947654}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4aebddd9aef1b9c47bd8be48b438f73f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  showEvent:
    m_PersistentCalls:
      m_Calls: []
  nextButton: {fileID: 7869783911563614362}
  endButton: {fileID: 4711573150848972325}
  tutorialSteps:
  - hasAction: 0
    instructionText: "\xD4i kh\xF4ng! Nh\u1EEFng qu\u1EA3 tr\u1EE9ng c\u1EE7a b\u1EA1n
      \u0111\xE3 b\u1ECB m\u1ED9t con qu\u1EA1 mang \u0111i r\u1ED3i."
    actionText: 
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "N\xF3 \u0111\xE3 gi\u1EA5u ch\xFAng \u1EDF n\u01A1i cao nh\u1EA5t.
      Nh\u01B0ng \u0111\u1EEBng lo, t\xF4i c\xF3 th\u1EC3 gi\xFAp b\u1EA1n."
    actionText: 
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "Nh\u1EA5n v\xF9ng b\xEAn d\u01B0\u1EDBi s\u1EBD gi\xFAp b\u1EA1n
      di chuy\u1EC3n theo h\u01B0\u1EDBng v\xE0 t\u1ED1c \u0111\u1ED9 t\u01B0\u01A1ng
      \u1EE9ng."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 7025730493600956204}
    delayHighlightTime: 0
    talkType: 1
  - hasAction: 1
    instructionText: 
    actionText: Move
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "Nh\u1EA5n v\xF9ng b\xEAn tr\xEAn s\u1EBD gi\xFAp b\u1EA1n c\xF3
      th\u1EC3 bay theo h\u01B0\u1EDBng t\u01B0\u01A1ng \u1EE9ng."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 211954078771275216}
    delayHighlightTime: 0
    talkType: 1
  - hasAction: 1
    instructionText: 
    actionText: Fly
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "Vu\u1ED1t l\xEAn / tr\xE1i / ph\u1EA3i s\u1EBD gi\xFAp b\u1EA1n
      l\u01B0\u1EDBt theo h\u01B0\u1EDBng \u0111\xF3."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 7091461000445978445}
    delayHighlightTime: 0
    talkType: 1
  - hasAction: 1
    instructionText: 
    actionText: Flash
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "L\u01B0u \xFD n\u0103ng l\u01B0\u1EE3ng c\u1EE7a b\u1EA1n khi
      bay v\xE0 di chuy\u1EC3n nh\xE9."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 5990852577983024358}
    delayHighlightTime: 0.25
    talkType: 0
  - hasAction: 0
    instructionText: "B\u1EA1n c\xF3 th\u1EC3 l\u1EF1a ch\u1ECDn lo\u1EA1i trang
      ph\u1EE5c cho m\xECnh \u1EDF \u0111\xE2y."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 9198140021073187718}
    delayHighlightTime: 0.5
    talkType: 0
  - hasAction: 0
    instructionText: "M\u1ED9t s\u1ED1 lo\u1EA1i d\u01B0\u1EE3c ph\u1EA9m \u0111\u1EB7c
      bi\u1EC7t c\u0169ng s\u1EBD gi\xFAp b\u1EA1n \u0111\xF3. B\u1EA1n c\xF3 th\u1EC3
      trao \u0111\u1ED5i b\u1EB1ng c\xF4n tr\xF9ng."
    actionText: 
    hasHighlight: 1
    canvasGroupHighlight: {fileID: 8519995938485705894}
    delayHighlightTime: 0.5
    talkType: 0
  - hasAction: 0
    instructionText: "L\u01B0u \xFD r\u1EB1ng b\u1EA1n kh\xF4ng th\u1EC3 s\u1EED
      d\u1EE5ng m\u1ED9t lo\u1EA1i d\u01B0\u1EE3c ph\u1EA9m nhi\u1EC1u l\u1EA7n c\xF9ng
      l\xFAc."
    actionText: 
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: "N\u1EBFu b\u1EA1n qu\xEAn c\xE1ch ch\u01A1i h\xE3y n\xF3i chuy\u1EC7n
      v\u1EDBi t\xF4i nh\xE9."
    actionText: 
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  - hasAction: 0
    instructionText: 
    actionText: 
    hasHighlight: 0
    canvasGroupHighlight: {fileID: 0}
    delayHighlightTime: 0
    talkType: 0
  instructionText: {fileID: 2641585889381672112}
  skipText: {fileID: 8361959891354323099}
